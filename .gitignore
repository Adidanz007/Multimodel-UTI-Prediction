# Data / experiments
data/
mlruns/
mlflow.db
notebooks/mlruns/
notebooks/mlflow.db

# Model weights (do not commit)
models/**/*.pkl
models/**/*.h5
models/**/*.keras
models/**/*.joblib

# Allow lightweight model metadata/configs
!models/*.json
!models/*.txt
!models/**/.gitkeep

# Generated results you do NOT want
results/embeddings/
results/**/*.npy
results/metrics/*.keras
results/metrics/*.h5

# Webapp generated artifacts (often sensitive)
webapp/uploads/
webapp/backend/uploads/
webapp/reports/
webapp/static/heatmaps/

__pycache__/
*.pyc