# =============================================================================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.spyderproject
.spyproject
*.sublime-workspace
*.sublime-project
.ropeproject/
.mypy_cache/
.dmypy.json
dmypy.json

# =============================================================================
